# Studio lock files — always transient
*.rbxl.lock
*.rbxlx.lock

# Binary place format. Does not diff, do not commit.
*.rbxl

# NOTE: .rbxlx is deliberately NOT ignored.
#
# Workspace geometry is not Rojo-managed, so the world exists only in the
# place file. It is now ~14,000 parts and cannot practically be regenerated
# from a builder script, so the XML place file IS the source of truth for
# everything under Workspace. Save the place into this folder as
# RNGArmory.rbxlx and commit it. See README, "Saving the world".

# Rojo build output
build/
*.rbxm
*.rbxmx

# OS
.DS_Store
Thumbs.db
